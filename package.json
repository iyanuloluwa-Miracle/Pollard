{
  "name": "pollard",
  "displayName": "Pollard",
  "description": "Find, verify and safely delete dead Git branches.",
  "version": "0.0.1",
  "publisher": "pollard-dev",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:pollard.branches"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Pollard runs git commands in the workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Pollard requires a local git repository."
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pollard",
          "title": "Pollard",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pollard": [
        {
          "id": "pollard.branches",
          "name": "Branches"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pollard.branches",
        "when": "!pollard.hasGitRepo",
        "contents": "No Git repository was found in this workspace.\n\nPollard needs an open folder containing a Git repository."
      },
      {
        "view": "pollard.branches",
        "when": "pollard.hasGitRepo && !pollard.hasScanned",
        "contents": "No branches have been scanned yet.\n\n[Scan for Dead Branches](command:pollard.scan)"
      },
      {
        "view": "pollard.branches",
        "when": "pollard.hasGitRepo && pollard.hasScanned && !pollard.isSignedIn",
        "contents": "Connect an account to check pull request status on your remote.\n\n[Connect GitHub](command:pollard.connectGithub)\n\n[Connect GitLab](command:pollard.connectGitlab)"
      },
      {
        "view": "pollard.branches",
        "when": "pollard.hasGitRepo && pollard.hasScanned && pollard.isSignedIn",
        "contents": "No dead branches found. Nice and tidy!"
      }
    ],
    "commands": [
      {
        "command": "pollard.scan",
        "title": "Pollard: Scan"
      },
      {
        "command": "pollard.clean",
        "title": "Pollard: Clean"
      },
      {
        "command": "pollard.restore",
        "title": "Pollard: Restore"
      },
      {
        "command": "pollard.refresh",
        "title": "Pollard: Refresh"
      },
      {
        "command": "pollard.connectGithub",
        "title": "Pollard: Connect GitHub"
      },
      {
        "command": "pollard.connectGitlab",
        "title": "Pollard: Connect GitLab"
      },
      {
        "command": "pollard.clearCache",
        "title": "Pollard: Clear Cache"
      },
      {
        "command": "pollard.deleteBranch",
        "title": "Pollard: Delete Branch",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pollard.deleteBranch",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "pollard.deleteBranch",
          "when": "view == pollard.branches && viewItem =~ /^(SAFE_MERGED|SAFE_SQUASH_MERGED|WARNING_CLOSED_PR|WARNING_UNMERGED|WARNING_NO_PR|UNKNOWN)$/",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Pollard",
      "properties": {
        "pollard.github.enterpriseHost": {
          "type": "string",
          "default": "",
          "description": "GitHub Enterprise hostname (e.g. github.mycompany.com), if not using github.com"
        },
        "pollard.gitlab.instanceUrl": {
          "type": "string",
          "default": "",
          "description": "Self-hosted GitLab base URL (e.g. https://gitlab.mycompany.com), if not using gitlab.com"
        },
        "pollard.cache.ttlMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "How long cached PR lookup results stay valid before a scan re-fetches them, in minutes"
        },
        "pollard.autoScanOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run Pollard: Scan when a workspace with a Git repository is opened. Off by default — scanning contacts GitHub/GitLab."
        },
        "pollard.autoScanIntervalMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Automatically re-run Pollard: Scan on this interval, in minutes. 0 disables periodic scanning (default). Values below 5 are treated as 5 minutes."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "vscode:prepublish": "npm run compile",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/vscode": "1.85.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
