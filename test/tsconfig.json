{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Test files import real src/ modules directly (no mocking — layers 3-4
    // exercise the real vscode.git extension), so rootDir/outDir must span
    // the whole repo, not just test/, otherwise tsc can't emit anything
    // under test/ whose relative imports still resolve to a compiled src/.
    "rootDir": "..",
    "outDir": "../out",
    "types": ["node", "mocha"]
  },
  "include": ["**/*.ts"],
  "exclude": []
}
